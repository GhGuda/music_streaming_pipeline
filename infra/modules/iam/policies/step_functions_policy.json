{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GlueAndLambdaOrchestration",
      "Effect": "Allow",
      "Action": [
        "glue:StartJobRun",
        "glue:GetJobRun",
        "glue:GetJobRuns",
        "lambda:InvokeFunction"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3ValidationReads",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::${scripts_bucket}/*"
      ]
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    }
  ]
}
